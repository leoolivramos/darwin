# === APP CONFIG ===
APP_NAME=Darwin
APP_ENV=development
APP_PORT=8080

# === PORTS ===
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
JAEGER_PORT=16686
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
LOKI_PORT=3100

# === GIT & REPOSITORY ===
GIT_REPO_SSH=git@github.com:leoolivramos/darwin.git
GIT_USER_NAME="Darwin"
GIT_USER_EMAIL=leomatisa1000@gmail.com
SSH_KEY_PATH=/run/secrets/id_rsa

# === TELEMETRY ===
PROMETHEUS_URL=http://prometheus:9090
GRAFANA_URL=http://grafana:3000
GRAFANA_ADMIN_PASSWORD=admin
JAEGER_URL=http://jaeger:16686
LOKI_URL=http://loki:3100

# === DETECTOR ===
DETECTOR_CHECK_INTERVAL=30
DETECTOR_THRESHOLD_CPU=0.80
DETECTOR_THRESHOLD_LATENCY=500
DETECTOR_THRESHOLD_ERROR_RATE=0.05

# === GENERATOR ===
GENERATOR_RULES_PATH=/app/heuristics
GENERATOR_LOG_LEVEL=INFO
GENERATOR_MODEL=tinyllama
GENERATOR_TIMEOUT=300

# === EVALUATOR ===
EVALUATOR_THRESHOLD_HIGH=0.85
EVALUATOR_THRESHOLD_LOW=0.5
EVALUATOR_IMPROVEMENT_FACTOR=1.1

# === ORCHESTRATOR ===
GENERATOR_URL=http://generator:5002
DETECTOR_URL=http://detector:5004
EVALUATOR_URL=http://evaluator:5001
ORCHESTRATOR_CANARY_PERCENTAGE=10
ORCHESTRATOR_ROLLBACK_THRESHOLD=0.5

# === DATABASE & CACHE ===
REDIS_URL=redis://redis:6379/0
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=darwin
POSTGRES_USER=darwin_user
POSTGRES_PASSWORD=darwin_pass

# === MINIO ===
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_ENDPOINT=http://minio:9000
MINIO_BUCKET_ARTIFACTS=darwin-artifacts
MINIO_BUCKET_PATCHES=darwin-patches
MINIO_BUCKET_TELEMETRY=darwin-telemetry

# === GITLAB ===
GITLAB_API_URL=https://gitlab.com/api/v4
GITLAB_TOKEN_FILE=/run/secrets/gitlab_token
GITLAB_PROJECT_ID=your_project_id

# === SECURITY ===
SECRET_KEY_BASE64=CHAVE_ALEATORIA_GERADA
JWT_SECRET=jwt_secret_key_here
ALLOWED_HOSTS=localhost,127.0.0.1,darwin-app

# === LOGGING ===
LOG_LEVEL=INFO
LOG_FORMAT=json
